# Supabase project settings → API
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AI Studio / Gemini Developer API (server-side only, never exposed to
# the client) — used to read receipt photos in the scan flow. Get a key at
# https://aistudio.google.com/apikey, tied to a GCP project with billing linked.
GEMINI_API_KEY=

# PayMongo (server-side only) — Premium subscription checkout.
# https://dashboard.paymongo.com -> Developers -> API Keys
PAYMONGO_SECRET_KEY=
# https://dashboard.paymongo.com -> Developers -> Webhooks (created against the
# deployed /api/premium/webhook URL)
PAYMONGO_WEBHOOK_SECRET=

# Supabase service-role key (server-side only, NEVER exposed to the client) —
# used only by the premium webhook. https://supabase.com/dashboard/project/_/settings/api
SUPABASE_SERVICE_ROLE_KEY=
